# OmniSift Application Configuration
# Copy this file to .env and adjust values as needed

# Application
APP_NAME=OmniSift
APP_VERSION=0.1.0
DEBUG=true
ENVIRONMENT=development

# Database
DATABASE_URL=postgresql+asyncpg://omnisift:omnisift_password@localhost:5432/omnisift
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=3600

# Object Storage (SeaweedFS S3 API)
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=omnisiftadmin
S3_SECRET_KEY=omnisiftsecret
S3_REGION=us-east-1
S3_BUCKET_DOCUMENTS=documents
S3_BUCKET_PROCESSED=processed
S3_BUCKET_EMBEDDINGS=embeddings

# Security
SECRET_KEY=your-secret-key-change-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080"]
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=["*"]
CORS_ALLOW_HEADERS=["*"]

# Processing
MAX_FILE_SIZE_MB=100
ALLOWED_FILE_TYPES=["application/pdf","application/vnd.openxmlformats-officedocument.wordprocessingml.document","text/plain","text/markdown","text/csv","application/json"]

# Embeddings
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
EMBEDDING_BATCH_SIZE=32

# Vector Search
VECTOR_SIMILARITY_THRESHOLD=0.7
VECTOR_MAX_RESULTS=10